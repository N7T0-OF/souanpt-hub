rules_version = '2';

// Règles de sécurité Firestore — souanpt.hub V2
// Principe : chaque document appartient à un UID. Personne ne peut lire/écrire
// les données d'un autre. Les profils et avis publiés sont lisibles
// publiquement. Les dossiers partagés par lien autorisent seulement `get`
// sans compte : un visiteur ne peut pas énumérer leurs collections.
//
// P0 — un document public doit rester VIDE de secrets. Ces règles ne font que
// verrouiller ce que le client écrit déjà : l'e-mail du profil et le mot de
// passe du portail ne sont plus jamais acceptés en clair (voir plus bas).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function owns(uid)  { return signedIn() && request.auth.uid == uid; }
    function isOwner()  { return signedIn() && request.auth.uid == resource.data.owner; }
    function creatingSelf() { return signedIn() && request.resource.data.owner == request.auth.uid; }
    function ownsRequest(token) {
      return signedIn()
        && get(/databases/$(database)/documents/requests/$(token)).data.owner == request.auth.uid;
    }

    // ── P0 : interdiction d'écrire un secret dans un document public ──
    // `users/{uid}` et `portals/{id}` sont en lecture ouverte (annuaire,
    // liens de portail sans compte) : n'importe qui peut les récupérer avec la
    // clé Web publique, sans authentification.
    // · email  → reste dans Auth Google (la page Compte lit Cloud.user().email)
    // · password → remplacé par passwordHash + passwordSalt (hachage itéré salé)
    // Chaque variant tolère la VALEUR HÉRITÉE (doc publié avant la correction)
    // et accepte sa SUPPRESSION — c'est ce qui rend la purge automatique au
    // login possible. Il interdit en revanche d'en introduire un neuf.
    function emailAllowed(d) {
      return !('email' in d) || d.get('email','') == '';
    }
    function emailAllowedUpdate(prev, next) {
      return !('email' in next) || next.get('email','') == ''
          || prev.get('email','') == next.get('email','');
    }
    function passwordAllowed(d) {
      return !('password' in d) || d.get('password','') == '';
    }
    function passwordAllowedUpdate(prev, next) {
      return !('password' in next) || next.get('password','') == ''
          || prev.get('password','') == next.get('password','');
    }

    // ── P0 : intégrité des profils publics ──
    // · `verified` et les compteurs du classement ne sont écrits que par un
    //   compte de service (qui contourne ces règles) : un créateur ne peut ni
    //   s'attribuer le badge « Vérifié » ni gonfler son rang. À la création,
    //   seules les valeurs neutres (false / 0) sont admises.
    // · un pseudo public est RÉSERVÉ dans handles/{pseudo} : users/{uid}.pseudo
    //   ne peut désigner qu'un pseudo que ce compte détient. Sans cela, deux
    //   comptes pouvaient porter le même pseudo et /u/<pseudo> servir l'un ou
    //   l'autre (usurpation du lien public).
    function protectedKeys() {
      return ['verified', 'views', 'visitors', 'projects', 'clicks', 'reviewsCount', 'reviewsAvg', 'uid', 'owner'];
    }
    function neutralProfile(d, uid) {
      return d.get('verified', false) == false
        && d.get('views', 0) == 0 && d.get('visitors', 0) == 0 && d.get('projects', 0) == 0
        && d.get('clicks', 0) == 0 && d.get('reviewsCount', 0) == 0 && d.get('reviewsAvg', 0) == 0
        && d.get('uid', uid) == uid && d.get('owner', uid) == uid;
    }
    function handlePath(h) { return /databases/$(database)/documents/handles/$(h); }
    // Le pseudo est réservé par ce compte à l'issue de l'écriture (lot compris).
    function holdsHandle(h) {
      return h is string && h.matches('^[a-z0-9_-]{2,40}$')
        && existsAfter(handlePath(h)) && getAfter(handlePath(h)).data.uid == request.auth.uid;
    }
    function pseudoOnCreate(d) { return !('pseudo' in d) || holdsHandle(d.pseudo); }
    // Changer de pseudo : réserver le nouveau ET libérer l'ancien dans le même
    // lot (un compte ne garde pas une collection de pseudos). Un pseudo hérité
    // jamais réservé, ou détenu par un autre compte, n'a rien à libérer.
    function pseudoOnUpdate(prev, next) {
      return !next.diff(prev).affectedKeys().hasAny(['pseudo'])
        || (holdsHandle(next.get('pseudo', null))
            && !(prev.get('pseudo', '') is string && prev.get('pseudo', '') != ''
                 && holdsHandle(prev.get('pseudo', ''))));
    }

    match /handles/{handle} {
      allow get: if true;
      allow list: if false;
      // Réservation unique : un document existant ne se recrée pas (update
      // interdit). Le profil doit désigner ce pseudo à l'issue de l'écriture,
      // ce qui empêche de réserver des pseudos inutilisés.
      allow create: if signedIn()
        && handle.matches('^[a-z0-9_-]{2,40}$')
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('pseudo', '') == handle;
      allow update: if false;
      // Libération : seulement par son détenteur, une fois que son profil ne
      // le désigne plus (changement de pseudo ou suppression du compte).
      allow delete: if signedIn() && resource.data.uid == request.auth.uid
        && (!existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
            || getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('pseudo', '') != handle);
    }

    // Profil public (portfolio /@pseudo) — lecture ouverte, écriture propriétaire
    match /users/{uid} {
      allow read: if true;
      // Une déclaration par opération : `resource.data` n'est jamais évalué
      // sur une création (il n'existe pas encore), `request.resource` sur une
      // suppression — sinon la condition ferait erreur et nierait l'accès.
      allow create: if owns(uid) && emailAllowed(request.resource.data)
        && neutralProfile(request.resource.data, uid)
        && pseudoOnCreate(request.resource.data);
      allow update: if owns(uid) && emailAllowedUpdate(resource.data, request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedKeys())
        && pseudoOnUpdate(resource.data, request.resource.data);
      allow delete: if owns(uid);

      // Sous-collections privées de l'utilisateur
      match /{sub}/{docId} {
        allow read, write: if owns(uid);
      }
    }

    // Portails clients — lecture par ID de lien, liste réservée au propriétaire
    match /portals/{id} {
      allow get: if true;
      allow list: if isOwner();
      allow create: if creatingSelf() && passwordAllowed(request.resource.data);
      allow update: if isOwner() && passwordAllowedUpdate(resource.data, request.resource.data);
      allow delete: if isOwner();
    }

    // Avis publiés — lisibles par tous, créés par un visiteur (validés ensuite), gérés par le propriétaire
    match /reviews/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['owner','author','text'])
                    && request.resource.data.status == 'pending';
      allow update, delete: if isOwner();
    }

    // ── Estimations partagées par lien, consultées SANS compte ──
    // ⚠ Ce document est PUBLIC par `get` sur son code : il ne doit contenir que ce que le
    // client a le droit de voir (lignes, total, délai, expiration). Le prix
    // plancher, le taux horaire et la marge restent dans users/{uid}/data,
    // qui n'est lisible que par son propriétaire.
    match /estimates/{code} {
      allow get: if true;
      allow list: if isOwner();
      allow create: if creatingSelf();
      allow update, delete: if isOwner();

      // Contre-offres. Le client n'a pas de compte — c'est tout l'intérêt du
      // lien — donc la création est ouverte, mais la FORME est verrouillée :
      // rien d'autre que ces champs ne peut être écrit, et le statut initial
      // est imposé pour qu'une offre ne puisse pas s'auto-accepter.
      match /offers/{offerId} {
        allow read: if true;
        // `kind` distingue une contre-offre ('counter') d'une acceptation
        // ('acceptance'). Une acceptation reste status:'pending' : c'est un
        // ENGAGEMENT DU CLIENT, que le créateur confirme ensuite côté tableau
        // de bord (modèle à deux parties). Le client ne peut donc jamais
        // marquer une estimation acceptée tout seul.
        allow create: if
             request.resource.data.keys().hasOnly(['author','amount','discountPercent','message','status','createdAt','kind'])
          && request.resource.data.status == 'pending'
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.amount < 1000000
          && (!('kind' in request.resource.data)
              || request.resource.data.kind in ['counter','acceptance'])
          && (!('message' in request.resource.data)
              || (request.resource.data.message is string && request.resource.data.message.size() <= 600))
          && (
               request.resource.data.author == 'client'
               || (signedIn()
                   && get(/databases/$(database)/documents/estimates/$(code)).data.owner == request.auth.uid
                   && request.resource.data.author == 'creator')
             );
        // Seul le créateur de l'estimation peut accepter, refuser ou effacer.
        allow update, delete: if signedIn()
          && get(/databases/$(database)/documents/estimates/$(code)).data.owner == request.auth.uid;
      }
    }

    // ── Formulaires de demande, remplis par le client SANS compte ──
    // Le créateur crée le document (vide, status:'open'). Le client public ne
    // peut QUE compléter SA demande tant qu'elle est ouverte, et rien d'autre :
    // il ne peut ni changer le propriétaire, ni rouvrir une demande traitée,
    // ni écrire un prix ou un statut interne (ces champs vivent ailleurs).
    match /requests/{token} {
      allow get: if true;
      allow list: if isOwner();
      allow create: if creatingSelf();
      allow delete: if isOwner();
      // Le créateur (connecté, propriétaire) : tout.
      // Le client (anonyme) : seulement passer 'open' → 'submitted' et remplir
      // les champs autorisés, jamais toucher owner/creatorName/status déjà figé.
      allow update: if isOwner()
        || (
             resource.data.status == 'open'
          && request.resource.data.owner == resource.data.owner
          && request.resource.data.status == 'submitted'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status','submittedAt','contact','service','answers','description','budget','deadline','links','attachments'])
        );

      // ── Questions complémentaires posées par le créateur ──
      // Le client (anonyme) ne peut QUE répondre à une question 'pending' de
      // SON token, et seulement les champs de réponse. Il ne peut ni modifier
      // la question, ni son type, ni la rouvrir, ni toucher un autre dossier.
      match /questions/{qid} {
        // Les notes internes restent visibles au seul créateur. La liste
        // publique doit filtrer `internal == false` dans sa requête Firestore.
        // Sans champ `internal`, le document reste privé jusqu'à classement.
        allow get: if ownsRequest(token) || resource.data.get('internal', true) == false;
        allow list: if ownsRequest(token) || resource.data.internal == false;
        allow create: if ownsRequest(token) && request.resource.data.internal is bool;
        allow delete: if ownsRequest(token);
        allow update: if request.resource.data.internal is bool && (
             // Le créateur : tout (relance, annulation, verrouillage…).
             ownsRequest(token)
             // Le client : répondre à une question en attente et non verrouillée.
          || (
               resource.data.get('internal', true) == false
            && resource.data.status == 'pending'
            && resource.data.locked != true
            && request.resource.data.status == 'answered'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer','answeredAt','status'])
             )
             // Le client : signaler qu'il a vu la question (accusé de lecture).
          || (resource.data.get('internal', true) == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenAt']))
        );
      }
    }

    // ── Notifications & file d'envoi ──
    // ÉCRITES UNIQUEMENT par le Worker (compte de service, qui contourne ces
    // règles). Aucun client ne peut donc fabriquer une fausse notification.
    // Le créateur LIT les siennes, et ne peut que les marquer lues/archivées.
    match /notifications/{id} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create, delete: if false;
      allow update: if signedIn() && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt','archivedAt']);
    }
    // File technique : lecture par le SEUL propriétaire (écran « État des
    // envois »), écriture réservée au Worker (compte de service).
    match /notification_jobs/{id} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow write: if false;
    }

    // ── Registre central des liens publics (jeton canonique par projet) ──
    // Lisible par `get` : le résolveur /c/<token> (sans compte) doit pouvoir y
    // lire l'étape et le statut du dossier. Il ne contient QUE des champs déjà
    // publics ailleurs (nom du projet, du client, total) — jamais de prix
    // plancher ni de note interne. Écrit uniquement par le propriétaire.
    match /public_links/{token} {
      allow get: if true;
      allow list: if isOwner();
      allow create: if creatingSelf();
      allow update, delete: if isOwner();
    }
  }
}
